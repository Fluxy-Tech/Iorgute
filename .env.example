DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=disable"
BETTER_AUTH_SECRET="gere-um-segredo-com-32-caracteres-ou-mais"
BETTER_AUTH_URL="http://localhost:8001"
NEXT_PUBLIC_APP_URL="http://localhost:8001"

# Armazenamento S3 (SeaweedFS) para as fotos dos produtos
SEAWEEDFS_S3_ENDPOINT="https://seu-servidor-s3"
SEAWEEDFS_S3_ACCESS_KEY=""
SEAWEEDFS_S3_SECRET_KEY=""
SEAWEEDFS_S3_BUCKET="iorgute"
SEAWEEDFS_S3_REGION="us-east-1"
SEAWEEDFS_S3_PREFIX="products"
# true = bucket com leitura pública (o navegador busca direto da URL acima)
# false = bucket privado (a aplicação entrega as fotos em /api/produtos/imagens/[id])
UPLOAD_PUBLIC_READ="false"
